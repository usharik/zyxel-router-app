<?xml version="1.0" encoding="utf-8"?>
<!-- Ни облачной копии, ни переноса на новый телефон: пароль зашифрован ключом этого устройства, отпечатки сертификатов
     и история устройств относятся к этой сети, а покупку Play восстановит сам. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
